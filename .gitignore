.DS_Store
._*

# Local browser/QA helper output. Keep screenshot PNGs and Markdown QA notes,
# but do not publish Chrome profiles, logs, or temporary server crumbs.
.server-*.pid
qa/**/*.log
qa/screenshots/*.snapshot.txt
qa/**/chrome-profile/
.playwright-cli/

# Local env/config secrets should never be part of the public repo.
.env
.env.*
*.local
